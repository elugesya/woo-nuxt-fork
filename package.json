{
  "name": "woonuxt",
  "private": true,
  "engines": {
    "node": "v22.12.0",
    "pnpm": "10.18.3"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host",
    "dev:ssl": "NODE_TLS_REJECT_UNAUTHORIZED=0 nuxt dev --https --ssl-cert localhost.pem --ssl-key localhost-key.pem",
    "generate": "BUILD_VERSION=$(date +%s) nuxt generate && node scripts/generate-google-feed.js",
    "preview": "nuxt preview",
    "serve": "nuxi generate && npx serve .output/public -l 8080",
    "postdeploy": "bash ./scripts/purge-cloudflare-cache.sh"
  },
  "dependencies": {
    "@stripe/stripe-js": "^8.1.0",
    "@vueform/slider": "^2.1.10",
    "@vueuse/core": "^13.9.0",
    "ipx": "^3.0.1",
    "lucide-vue-next": "^0.548.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.71",
    "@iconify-json/radix-icons": "^1.2.5",
    "@nuxt/icon": "^2.0.0",
    "@nuxt/image": "1.11.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/i18n": "^10.1.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tailwindcss/typography": "^0.5.19",
    "tailwindcss": "^3.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nuxt": "^4.1.3",
    "nuxt-graphql-client": "^0.2.46",
    "nuxt-gtag": "^4.1.0",
    "oxc-parser": "0.94.0",
    "prettier": "^3.6.2",
    "radix-vue": "^1.9.17",
    "shadcn-nuxt": "^2.3.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "packageManager": "pnpm@10.18.3"
}
