# Required
GQL_HOST="https://example.com/graphql"   # must end with /graphql
NUXT_IMAGE_DOMAINS="wp.example.com,cdn.example.com"  # hostnames only, comma-separated (no https://)

# Optional (used as the Origin header when calling WordPress)
APP_HOST="http://localhost:3000"

# If you don't have the plugin installed, you can configure the rest of the settings here.
# number of products to be displayed per page
NUXT_PUBLIC_PRODUCTS_PER_PAGE="24"

# Stripe API key
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_abcdefghijklmnopqrstuvwxyz"

# Color of input and button elements
PRIMARY_COLOR="#ff0000"

# WhatsApp phone number (with country code, without + or spaces)
NUXT_PUBLIC_WHATSAPP_PHONE="905551234567"

# Organization/Company details for structured data (JSON-LD)
NUXT_PUBLIC_SITE_NAME="WooNuxt"
NUXT_PUBLIC_SITE_SHORT_DESCRIPTION="Modern, fast, and SEO friendly ecommerce store built with Nuxt and WooCommerce."
NUXT_PUBLIC_SITE_DESCRIPTION="WooNuxt is unmatched when it comes to performance and scalability. Reap the benefits of having a online store that out performs all of your competitors."
NUXT_PUBLIC_SITE_IMAGE="https://example.com/og-image.jpg"  # Open Graph image for social sharing
NUXT_PUBLIC_ORGANIZATION_LOGO="/logo.svg"  # path or full URL
NUXT_PUBLIC_ORGANIZATION_CONTACT_EMAIL="info@example.com"
NUXT_PUBLIC_ORGANIZATION_PHONE="+90 555 123 4567"
NUXT_PUBLIC_ORGANIZATION_ADDRESS="Adres Bilgisi, İlçe, İl"
NUXT_PUBLIC_ORGANIZATION_SOCIAL_FACEBOOK="https://facebook.com/yourpage"
NUXT_PUBLIC_ORGANIZATION_SOCIAL_TWITTER="https://twitter.com/yourhandle"
NUXT_PUBLIC_ORGANIZATION_SOCIAL_INSTAGRAM="https://instagram.com/yourprofile"
NUXT_PUBLIC_GOOGLE_MAPS_EMBED=""  # Google Maps iframe embed URL (optional)

# Currency code for product pricing (defaults to TRY if not set)
NUXT_PUBLIC_CURRENCY_CODE="TRY"

# Front-end URL for canonical links and schema (prod: https://example.com, dev: http://localhost:3000)
NUXT_PUBLIC_FRONT_END_URL="http://localhost:3000"

# Google Integration Parameters
# Google Analytics 4
NUXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"  # GA4 Measurement ID

# Google Tag Manager
NUXT_PUBLIC_GTM_ID="GTM-XXXXXXX"  # Google Tag Manager Container ID

# Google Site Verification (for Search Console)
GOOGLE_SITE_VERIFICATION="your-verification-code"  # Meta tag verification code

# Bing Site Verification (for Bing Webmaster Tools)
BING_SITE_VERIFICATION="your-bing-verification-code"  # Meta tag verification code

# Google Merchant Center (for product feed)
NUXT_PUBLIC_GOOGLE_MERCHANT_SHOP_NAME="Neta Marine"  # Your shop name for product feed
NUXT_PUBLIC_GOOGLE_MERCHANT_BRAND="Neta Marine"  # Default brand name if product doesn't have one

# Analytics Settings
NUXT_PUBLIC_ANALYTICS_DEBUG="false"  # Set to "true" for development debugging
NUXT_PUBLIC_GTM_DEBUG="false"  # Set to "true" for GTM preview mode

# Cache Busting & Cloudflare Integration
BUILD_VERSION=""  # Auto-generated during build, leave empty
CLOUDFLARE_ZONE_ID=""  # Your Cloudflare Zone ID for cache purging
CLOUDFLARE_API_TOKEN=""  # Cloudflare API token with cache purge permission
CLOUDFLARE_PURGE_ON_DEPLOY="true"  # Set to "true" to auto-purge cache after deployment

