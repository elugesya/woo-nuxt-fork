            <!-- Checkout Button -->
            <NuxtLink to="/odeme" @click="isShowingCart = false">
              <Button
                :class="cn(
                  'w-full h-12 text-lg font-semibold rounded-xl',
                  'bg-gradient-ocean text-white',
                  'hover:shadow-ocean transition-all duration-300'
