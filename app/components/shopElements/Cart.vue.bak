<script setup lang="ts">
/**
 * 🌊 Cart - Marine Themed
 *
 * Slide-out cart with ocean-inspired styling.
 * Uses ShadCN Sheet component for proper reactivity.
 */
import { cn } from '@/lib/utils';
import { X, ShoppingCart, Anchor, Waves, Trash2, ArrowRight } from 'lucide-vue-next';
import { Button } from '@/components/ui/button';

const { cart, isUpdatingCart, isShowingCart } = useCart();
</script>

<template>
  <!-- Cart Panel using ShadCN Sheet for proper reactivity -->
  <Sheet :open="isShowingCart" @update:open="isShowingCart = $event">
